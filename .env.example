# Copy to .env and adjust. Every setting maps to docuflow/core/config.py (case-insensitive).

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:4200"]

# Infrastructure (values for running the API on the host against `docker compose up postgres redis s3`)
DATABASE_URL=postgresql+asyncpg://docuflow:docuflow@localhost:5433/docuflow
REDIS_URL=redis://localhost:6379/0

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me

# Storage: "local" (./var/uploads) or "s3" (AWS S3, SeaweedFS, MinIO, Cloudflare R2)
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://localhost:8333
# S3_ACCESS_KEY_ID=docuflow
# S3_SECRET_ACCESS_KEY=docuflow-secret
# S3_BUCKET=docuflow

# AI extraction: "mock" runs offline; "claude" calls the Anthropic API
EXTRACTOR=mock
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Webhooks: allow localhost/private targets only for local testing
WEBHOOK_ALLOW_PRIVATE_HOSTS=true

# Google Sheets export (optional): path to a service account JSON key
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
